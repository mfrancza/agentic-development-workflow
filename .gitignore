# Node.js
.github/scripts/node_modules/
.github/scripts/dist/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# terraform.tfvars is committed operational config (non-secret: repo owner/name,
# agent allowlist, auto-trigger flags, assignee/reviewer lists).  Secrets stay
# in Actions secrets only — nothing in terraform.tfvars is a secret.
# All other .tfvars files (local overrides, one-off experiments) remain ignored.
*.tfvars
!*.tfvars.example
!terraform/terraform.tfvars

# Agent App private keys (PEM downloads from GitHub)
*.pem
