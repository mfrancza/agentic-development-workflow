repo_owner           = "your-github-username"
repo_name            = "agentic-development-workflow"
# Include the agent bot identities (e.g. the developer agent) so agents can
# apply agent:* labels (like `agent:review`) and trigger other agents. The
# `[bot]` suffix matches `github.event.sender.login` for GitHub App events.
agent_allowlist = [
  "your-github-username",
  "<developer-agent-app-slug>[bot]",
  "<reviewer-agent-app-slug>[bot]",
]
default_model = "sonnet"

# Humans to assign to issues and PRs when the agent applies the human-required
# label (e.g. escalations requiring security, billing, or permission decisions).
# Stored as ADMIN_ASSIGNEES Actions variable; workflows parse it with fromJSON().
# Leave empty ([]) if you prefer to assign manually.
admin_assignees = [
  "your-github-username",
]

# Humans to request as PR reviewers when the agent opens a PR and wants human
# code review. Stored as CODE_REVIEWERS Actions variable; workflows parse it
# with fromJSON(). Leave empty ([]) to skip automatic reviewer requests.
code_reviewers = [
  "your-github-username",
]

# Auto-trigger configuration. Set a key to true to automatically apply the
# corresponding agent:* label at the natural upstream signal, advancing the
# SDLC pipeline without manual labeling. All keys default to false (opt-in).
# See docs/design/auto-trigger-agents.md for full behavior and security notes.
auto_trigger_agents = {
  groom     = false
  design    = false
  developer = false
  review    = false
}
