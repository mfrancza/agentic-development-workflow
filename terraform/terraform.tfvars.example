repo_owner           = "your-github-username"
repo_name            = "agentic-development-workflow"
# Include the agent bot identities (e.g. the developer agent) so agents can
# apply agent:* labels (like `agent:review`) and trigger other agents. The
# `[bot]` suffix matches `github.event.sender.login` for GitHub App events.
agent_allowlist = [
  "your-github-username",
  "<developer-agent-app-slug>[bot]",
  "<reviewer-agent-app-slug>[bot]",
]
default_model = "sonnet"

# Design-agent default model. When set, agent-design workflows use this value
# instead of DEFAULT_MODEL, letting you give the design stage a different model
# tier from the rest of the SDLC (e.g. a more capable model for planning-heavy
# work) without changing other agent types. Leave unset (empty string "") to fall
# back to DEFAULT_MODEL — the existing behavior is preserved by default.
# Stored as the DESIGN_DEFAULT_MODEL Actions variable.
# design_default_model = "opus"

# Humans to assign to issues and PRs when the agent applies the human-required
# label (e.g. escalations requiring security, billing, or permission decisions).
# Stored as ADMIN_ASSIGNEES Actions variable; workflows parse it with fromJSON().
# Leave empty ([]) if you prefer to assign manually.
admin_assignees = [
  "your-github-username",
]

# Humans to request as PR reviewers when the agent opens a PR and wants human
# code review. Stored as CODE_REVIEWERS Actions variable; workflows parse it
# with fromJSON(). Leave empty ([]) to skip automatic reviewer requests.
code_reviewers = [
  "your-github-username",
]

# Opt-in gate for developer-authored PRs. Leave disabled (the default) until
# the corresponding workflow and activity are configured. When enabled, set
# developer_bot_login to the developer-agent App's <slug>[bot] login.
# developer_bot_login              = "<developer-agent-app-slug>[bot]"
# require_two_developer_approvals = true

# Auto-trigger configuration. Set a key to true to automatically apply the
# corresponding agent:* label at the natural upstream signal, advancing the
# SDLC pipeline without manual labeling. All keys default to false (opt-in).
# See docs/design/auto-trigger-agents.md for full behavior and security notes.
auto_trigger_agents = {
  groom     = false
  design    = false
  developer = false
  review    = false
}

# Ordered list of model identifiers for the multi-reviewer feature. Each entry
# is a model name accepted by the agent --model flag. Leave empty ([]) to
# disable multi-reviewer (the default). Stored as REVIEWER_MODELS Actions variable.
# reviewer_models = ["sonnet", "claude-sonnet-4-5", "gpt-5.6-sol"]

# Reviewer model-pair preferences. When enabled, the agent-review workflow picks
# a reviewer model based on the authoring model of the PR (recorded in the PR
# body by the developer/design agent). Explicit model:review:* / model:* labels
# on the PR take precedence over this setting. Defaults to enabled = false
# (fail-safe opt-in — no behavioral change until you explicitly set enabled = true).
# Stored as the REVIEW_MODEL_PAIRING Actions variable (JSON-encoded object).
# See docs/design/configurable-model-pair-preferences.md for resolver semantics.
#
# To opt in with the default different-vendor-same-class policy:
# review_model_pairing = {
#   enabled           = true
#   policy            = "different-vendor-same-class"
#   preferred_vendors = ["openai", "xai", "anthropic"]
#   explicit_map      = {}
#   fallback_chain    = ["default-model"]
# }
#
# To use an explicit author → reviewer map instead:
# review_model_pairing = {
#   enabled           = true
#   policy            = "explicit-map"
#   preferred_vendors = ["openai", "xai", "anthropic"]
#   explicit_map      = {
#     "sonnet"           = "gpt-5.6-terra"
#     "claude-sonnet-4-5" = "gpt-5"
#     "opus"             = "gpt-5.6-sol"
#   }
#   fallback_chain    = ["different-vendor-same-class", "default-model"]
# }
